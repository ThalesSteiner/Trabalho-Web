{
  "name": "Trabalho Web",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/trabalho-web",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "54321-54323": { "onAutoForward": "ignore" }
  },
  "postCreateCommand": "sudo chown node:node backend/node_modules && cd backend && npm install",
  "postStartCommand": "cd backend && npx supabase start",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "prettier.prettierPath": "./backend/node_modules/prettier"
      }
    }
  }
}
